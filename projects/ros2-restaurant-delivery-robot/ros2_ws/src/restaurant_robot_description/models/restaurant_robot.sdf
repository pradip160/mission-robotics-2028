<sdf version='1.11'>
  <model name='restaurant_robot'>
    <link name='base_link'>
      <inertial>
        <pose>0.05 0 0.1 0 0 0</pose>
        <mass>10</mass>
        <inertia>
          <ixx>0.2416666667</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.5666666667</iyy>
          <iyz>0</iyz>
          <izz>0.7416666667</izz>
        </inertia>
      </inertial>
      <collision name='base_link_collision'>
        <pose>0 0 0.10000000000000001 0 0 0</pose>
        <geometry>
          <box>
            <size>0.80000000000000004 0.5 0.20000000000000001</size>
          </box>
        </geometry>
      </collision>
      <visual name='base_link_viusal'>
        <pose>0 0 0.1 0 0 0</pose>
        <geometry>
          <box>
            <size>0.8 0.5 0.2</size>
          </box>
        </geometry>
        <material>
          <diffuse>0.125 0.625 1 1</diffuse>
          <ambient>0.125 0.625 1 1</ambient>
        </material>
      </visual>
      <sensor name='front_lidar' type='gpu_lidar'>
        <pose>0.25 0 0.23 0 0 0</pose>
        <topic>lidar</topic>
        <update_rate>10</update_rate>
        <ray>
          <scan>
            <horizontal>
              <samples>181</samples>
              <resolution>1</resolution>
              <min_angle>-1.5708</min_angle>
              <max_angle>1.5708</max_angle>
            </horizontal>
          </scan>
          <range> 
            <min>0.12</min>
            <max>8.0</max>
            <resolution>0.01</resolution>
          </range>
          </ray>
          <always_on>true</always_on>
          <visualize>true</visualize>
        </sensor>
    </link>    
    <joint name='left_wheel_joint' type='revolute'>
      <pose relative_to='base_link'>0 0.29999999999999999 0.050000000000000003 0 0 0</pose>
      <parent>base_link</parent>
      <child>left_wheel</child>
      <axis>
        <xyz>0 1 0</xyz>
        <limit>
          <lower>-inf</lower>
          <upper>inf</upper>
        </limit>
        <dynamics>
          <spring_reference>0</spring_reference>
          <spring_stiffness>0</spring_stiffness>
        </dynamics>
      </axis>
    </joint>
    <link name='left_wheel'>
      <pose relative_to='left_wheel_joint'>0 0 0 0 0 0</pose>
      <inertial>
        <pose>0 0 0 0 0 0</pose>
        <mass>1</mass>
        <inertia>
          <ixx>0.0027100000000000002</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.0050000000000000001</iyy>
          <iyz>0</iyz>
          <izz>0.0027100000000000002</izz>
        </inertia>
      </inertial>
      <collision name='left_wheel_collision'>
        <pose>0 0 0 1.5708 0 0</pose>
        <geometry>
          <cylinder>
            <length>0.005</length>
            <radius>0.10000000000000001</radius>
          </cylinder>
        </geometry>
      </collision>
      <visual name='left_wheel_visual'>
        <pose>0 0 0 1.5708 0 0</pose>
        <geometry>
          <cylinder>
            <length>0.050000000000000003</length>
            <radius>0.10000000000000001</radius>
          </cylinder>
        </geometry>
      </visual>
    </link>
    <joint name='right_wheel_joint' type='revolute'>
      <pose relative_to='base_link'>0 -0.29999999999999999 0.050000000000000003 0 0 0</pose>
      <parent>base_link</parent>
      <child>right_wheel</child>
      <axis>
        <xyz>0 1 0</xyz>
        <limit>
          <lower>-inf</lower>
          <upper>inf</upper>
        </limit>
        <dynamics>
          <spring_reference>0</spring_reference>
          <spring_stiffness>0</spring_stiffness>
        </dynamics>
      </axis>
    </joint>
    <link name='right_wheel'>
      <pose relative_to='right_wheel_joint'>0 0 0 0 0 0</pose>
      <inertial>
        <pose>0 0 0 0 0 0</pose>
        <mass>1</mass>
        <inertia>
          <ixx>0.0027100000000000002</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.0050000000000000001</iyy>
          <iyz>0</iyz>
          <izz>0.0027100000000000002</izz>
        </inertia>
      </inertial>
      <collision name='right_wheel_collision'>
        <pose>0 0 0 1.5708 0 0</pose>
        <geometry>
          <cylinder>
            <length>0.005</length>
            <radius>0.10000000000000001</radius>
          </cylinder>
        </geometry>
      </collision>
      <visual name='right_wheel_visual'>
        <pose>0 0 0 1.5708 0 0</pose>
        <geometry>
          <cylinder>
            <length>0.050000000000000003</length>
            <radius>0.10000000000000001</radius>
          </cylinder>
        </geometry>
      </visual>
    </link>
    <link name='caster_fork'>
      <pose relative_to='base_link'>0.30 0 0 0 0 0</pose>

      <inertial>
        <mass>0.1</mass>
        <inertia>
          <ixx>0.0001</ixx>
          <iyy>0.0001</iyy>
          <izz>0.0001</izz>
        </inertia>
      </inertial>
    </link>

    <joint name='caster_swivel_joint' type='revolute'>
      <pose relative_to='base_link'>0.30 0 0 0 0 0</pose>

      <parent>base_link</parent>
      <child>caster_fork</child>

      <axis>
        <xyz>0 0 1</xyz>
        <limit>
          <lower>-inf</lower>
          <upper>inf</upper>
        </limit>
      </axis>
    </joint>
    <link name='caster_wheel'>
      <pose relative_to='caster_fork'>-0.02 0 0 0 0 0</pose>

      <inertial>
        <mass>0.1</mass>
        <inertia>
          <ixx>0.0001</ixx>
          <iyy>0.0001</iyy>
          <izz>0.0001</izz>
        </inertia>
      </inertial>

      <collision name='caster_wheel_collision'>
        <pose>0 0 0 1.5708 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.05</radius>
            <length>0.03</length>
          </cylinder>
        </geometry>
      </collision>

      <visual name='caster_wheel_visual'>
        <pose>0 0 0 1.5708 0 0</pose>
        <geometry>
          <cylinder>
            <radius>0.05</radius>
            <length>0.03</length>
          </cylinder>
        </geometry>
      </visual>
    </link>

    <joint name='caster_wheel_joint' type='revolute'>
      <pose relative_to='caster_fork'>-0.02 0 0 0 0 0</pose>

      <parent>caster_fork</parent>
      <child>caster_wheel</child>

      <axis>
        <xyz>0 1 0</xyz>
        <limit>
          <lower>-inf</lower>
          <upper>inf</upper>
        </limit>
      </axis>
    </joint>
    <plugin
      filename="gz-sim-diff-drive-system"
      name="gz::sim::systems::DiffDrive">

      <left_joint>left_wheel_joint</left_joint>
      <right_joint>right_wheel_joint</right_joint>

      <wheel_separation>0.60</wheel_separation>
      <wheel_radius>0.10</wheel_radius>

      <odom_publish_frequency>10</odom_publish_frequency>

      <topic>cmd_vel</topic>
    </plugin>
    <plugin 
      filename="gz-sim-joint-state-publisher-system"
      name="gz::sim::systems::JointStatePublisher">

      <joint_name>left_wheel_joint</joint_name>
      <joint_name>right_wheel_joint</joint_name>

    </plugin>
  </model>
</sdf>
