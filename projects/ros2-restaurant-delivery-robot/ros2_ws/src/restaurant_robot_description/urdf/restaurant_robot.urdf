<?xml version="1.0"?>

  <robot name ="restaurant_robot">

    <link name="base_link">

      <visual>

        <origin xyz="0 0 0.1"/>

        <geometry>
          <box size="0.8 0.5 0.2"/>
        </geometry>

        <material name="robot_blue">
          <color rgba="0.1 0.5 1.0 1.0"/>
        </material>

      </visual>

      <collision>
        <origin xyz="0 0 0.1"/>

        <geometry>
          <box size="0.8 0.5 0.2"/>
        </geometry>
      </collision>

      <inertial>
        <origin xyz="0 0 0.1"/>

        <mass value="10.0"/>

        <inertia
          ixx="0.2417"
          ixy="0.0"
          ixz="0.0"
          iyy="0.5667"
          iyz="0.0"
          izz="0.7417"/>
        </inertial>

    </link>

    <joint name="left_wheel_joint" type="continuous">

      <parent link="base_link"/>
      <child link="left_wheel"/>

      <origin xyz="0 0.30 0.05"/>
      <axis xyz="0 1 0"/>

    </joint>

    <link name="left_wheel">

      <visual>
        <origin rpy="1.5708 0 0"/>

        <geometry>
          <cylinder radius="0.1" length="0.05"/>
        </geometry>

      </visual>
     
      <collision>
        <origin rpy="1.5708 0 0"/>

        <geometry>
          <cylinder radius="0.1" length="0.05"/>

        </geometry>
      </collision>

      <inertial>
        <mass value="1.0"/>

        <inertia
          ixx="0.00271"
          ixy="0.0"
          ixz="0.0"
          iyy="0.005"
          iyz="0.0"
          izz="0.00271"/>
        </inertial>
    </link>

    <joint name="right_wheel_joint" type="continuous">
 
      <parent link="base_link"/>
      <child link="right_wheel"/>

      <origin xyz="0 -0.30 0.05"/>
      <axis xyz="0 1 0"/>

    </joint>

    <link name="right_wheel">

      <visual>
        <origin rpy="1.5708 0 0"/>

        <geometry>
          <cylinder radius="0.1" length="0.05"/>
        </geometry>

      </visual>

      <collision>
        <origin rpy="1.5708 0 0"/>

        <geometry>
          <cylinder radius="0.1" length="0.05"/>
        </geometry>

      </collision>
  
      <inertial>
        <mass value="1.0"/>
    
        <inertia
          ixx="0.00271"
          ixy="0.0"
          ixz="0.0"
          iyy="0.005"
          iyz="0.0"
          izz="0.00271"/>
        </inertial>
      </link>

      <joint name="front_caster_joint" type="fixed">

        <parent link="base_link"/>
        <child link="front_caster"/>

        <origin xyz="0.30 0 0"/>
        
      </joint>

      <link name="front_caster">

        <visual>
          <geometry>
            <sphere radius="0.05"/>
          </geometry>
        </visual>

        <collision>
          <geometry>
            <sphere radius="0.05"/>
          </geometry>
        </collision>

     <inertial>
       <mass value="0.5"/>

       <inertia
         ixx="0.0005"
         ixy="0.0"
         ixz="0.0"
         iyy="0.0005"
         iyz="0.0"
         izz="0.0005"/>
       </inertial>
     </link>

  </robot>

