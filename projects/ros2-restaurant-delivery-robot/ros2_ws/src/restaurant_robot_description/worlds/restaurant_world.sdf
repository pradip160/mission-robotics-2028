<sdf version='1.11'>
  <world name='restaurant_world'>

    <plugin
      filename='gz-sim-physics-system'
      name='gz::sim::systems::Physics'>
    </plugin>

    <plugin
      filename='gz-sim-user-commands-system'
      name='gz::sim::systems::UserCommands'>
    </plugin>

    <plugin
      filename='gz-sim-scene-broadcaster-system'
      name='gz::sim::systems::SceneBroadcaster'>
    </plugin>

    <plugin
      filename='gz-sim-sensors-system'
      name='gz::sim::systems::Sensors'>
      <render_engine>ogre2</render_engine>
    </plugin>

    <gravity>0 0 -9.8</gravity>

    <light type='directional' name='sun'>
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>
  
    <scene> 
      <ambient> 0.5 0.5 0.5 1</ambient> 
      <background>0.7 0.8 0.9 1</background> 
    </scene> 

    <model name='ground'>
      <static>true</static>
      <link name='ground_link'>
        <collision name='ground_collision'>
          <pose>0 0 -0.05 0 0 0 </pose>
          <geometry>
            <box>
              <size>30 24 0.1</size>
            </box>
          </geometry>
        </collision>

        <visual name='ground_visual'>
          <pose>0 0 -0.05 0 0 0</pose>
          <geometry>
            <box>
              <size>30 24 0.1</size>
            </box>
          </geometry>
          <material> 
            <ambient>0.55 0.55 0.55 1</ambient>
            <diffuse>0.55 0.55 0.55 1</diffuse> 
         </material>  
        </visual>
      </link>
    </model>

    <model name='south_wall_left'>
      <static>true</static>

      <pose>-6.6 -8.9 1.4 0 0 0</pose>  

      <link name='south_left_wall_link'>

        <collision name='wall_collision'>
          <geometry>
            <box> 
              <size>10.8 0.2 2.8</size>
            </box> 
          </geometry> 
        </collision>

        <visual name='south_left_wall_visual'> 
          <geometry> 
            <box>
              <size>10.8 0.2 2.8</size> 
            </box>
          </geometry>

          <material> 
            <ambient>1.0 0.88 0.65 1</ambient> 
            <diffuse>1.0 0.88 0.65 1</diffuse> 
          </material> 
        </visual> 
      
      </link>
    </model> 
    
    <model name='south_wall_right'>
      <static>true</static> 

      <pose>6.6 -8.9 1.4 0 0 0</pose> 

      <link name='south_right_wall_link'> 

        <collision name='south_right_wall_collision'> 
          <geometry>
            <box> 
              <size>10.8 0.2 2.8</size> 
            </box> 
          </geometry> 
        </collision> 

        <visual name='south_right_wall_visual'> 
          <geometry> 
            <box> 
              <size>10.8 0.2 2.8</size>
            </box> 
          </geometry>
 
          <material> 
            <ambient>1.0 0.88 0.65 1</ambient> 
            <diffuse>1.0 0.88 0.65 1</diffuse>
          </material> 
          
        </visual>
      
      </link>
    </model>

    <model name='east_wall'>
      <static>true</static> 

      <pose>11.9 0 1.4 0 0 0</pose> 

      <link name='east_wall_link'> 
      
        <collision name='east_wall_collision'>
          <geometry>
            <box> 
              <size>0.2 17.6 2.8</size>
            </box> 
          </geometry>
        </collision> 

        <visual name='east_wall_visual'>
          <geometry> 
            <box> 
              <size>0.2 17.6 2.8</size> 
            </box> 
          </geometry>

          <material> 
            <ambient>1.0 0.88 0.65 1</ambient> 
            <diffuse>1.0 0.88 0.65 1</diffuse> 
          </material> 
 
        </visual> 
      </link> 
    </model> 
 
    <model name='west_wall'>
      <static>true</static>

      <pose>-11.9 0 1.4 0 0 0</pose>

      <link name='west_wall_link'>

        <collision name='west_wall_collision'>
          <geometry>
            <box>
              <size>0.2 17.6 2.8</size>
            </box>
          </geometry>
        </collision>

        <visual name='west_wall_visual'>
          <geometry>
            <box>
              <size>0.2 17.6 2.8</size>
            </box>
          </geometry>

          <material>
            <ambient>1.0 0.88 0.65 1</ambient>
            <diffuse>1.0 0.88 0.65 1</diffuse>
          </material>

        </visual>
      </link>
    </model> 

    <model name='north_left_wall'>
      <static>true</static> 

      <pose>-9.3 8.9 1.4 0 0 0</pose>

      <link name='north_left_wall_link'>

        <collision name='north_left_wall_collision'>
          <geometry>
            <box>
              <size>5.4 0.2 2.8</size> 
            </box>
          </geometry>
        </collision>

        <visual name='north_left_wall_visual'> 
          <geometry>
            <box>
              <size>5.4 0.2 2.8</size> 
            </box>
          </geometry>            
        
          <material>
            <ambient>1.0 0.88 0.65 1</ambient> 
            <diffuse>1.0 0.88 0.65 1</diffuse> 
          </material> 
        
        </visual> 
      </link>
    </model> 

    <model name='north_right_wall'> 
      <static>true</static> 

      <pose>3.3 8.9 1.4 0 0 0</pose> 

      <link name='north_right_wall_link'> 

        <collision name='north_right_wall_collision'> 
          <geometry>
            <box> 
              <size>17.4 0.2 2.8</size> 
            </box> 
          </geometry> 
        </collision> 

        <visual name='north_right_wall_visual'>
          <geometry>
            <box> 
              <size>17.4 0.2 2.8</size> 
            </box> 
          </geometry> 
        
          <material> 
            <ambient>1.0 0.88 0.65 1</ambient> 
            <diffuse>1.0 0.88 0.65 1</diffuse> 
          </material> 
        </visual> 
      </link> 
    </model> 

    <model name='kitchen_east_counter_north'> 
      <static>true</static>

      <pose>-4.8 7.35 0.55 0 0 0</pose> 

      <link name='counter_link'>

        <collision name='counter_collision'> 
          <geometry>
            <box>
              <size>0.2 2.9 1.1</size>
            </box>
          </geometry>
        </collision>

        <visual name='counter_visual'>
          <geometry>
            <box>
              <size>0.2 2.9 1.1</size>
            </box>
          </geometry>
        
          <material> 
            <ambient>0.45 0.47 0.48 1</ambient>
            <diffuse>0.45 0.47 0.48 1</diffuse> 
          </material> 
        </visual>

      </link>
    </model> 

    <model name='kitchen_east_counter_south'>
      <static>true</static>

      <pose>-4.8 3.35 0.55 0 0 0</pose>

      <link name='counter_link'>
      
        <collision name='counter_collision'>
          <geometry>
            <box>
              <size>0.2 1.1 1.1</size>
            </box>
          </geometry>
        </collision>

        <visual name='counter_visual'>
          <geometry>
            <box>
              <size>0.2 1.1 1.1</size>
            </box>
          </geometry>
       
          <material>
            <ambient>0.45 0.47 0.49 1</ambient>
            <diffuse>0.45 0.47 0.49 1</diffuse>  
          </material>
 
        </visual>
      </link>
    </model> 

    <model name='south_partition_west'>
      <static>true</static>

      <pose>-11.2 2.8 1.4 0 0 0</pose>

      <link name='pratition_link'>

        <collision name='pratiton_collision'>
          <geometry>
            <box>
              <size>1.2 0.2 2.8</size>
            </box>
          </geometry>
        </collision>

        <visual name='pratition_visual'>
          <geometry>
            <box>
              <size>1.2 0.2 2.8</size>
            </box>
          </geometry>

          <material>
            <ambient>0.45 0.47 0.49 1</ambient>
            <diffuse>0.45 0.47 0.49 1</diffuse>
          </material>

        </visual>
      </link>
    </model>
          

    <model name='south_partition_east'>
      <static>true</static>

      <pose>-6.9 2.8 1.4 0 0 0</pose>

      <link name='pratition_link'>

        <collision name='pratiton_collision'>
          <geometry>
            <box>
              <size>4.2 0.2 2.8</size>
            </box>
          </geometry>
        </collision>

        <visual name='pratition_visual'>
          <geometry>
            <box>
              <size>4.2 0.2 2.8</size>
            </box>
          </geometry>

          <material>
            <ambient>0.45 0.47 0.49 1</ambient>
            <diffuse>0.45 0.47 0.49 1</diffuse>
          </material>

        </visual>
      </link>
    </model>



  </world>
</sdf>
 
